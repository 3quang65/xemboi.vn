# ==========================================================
# Cấu hình bắt buộc cho Trang thí nghiệm R1 (/tu-vi-2027 & /quan-tri/r1)
# ==========================================================
# Chuỗi kết nối PostgreSQL thật (ở NODE_ENV=production bắt buộc phải kết nối được, không dùng tệp dự phòng)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xemboi_vn?schema=public"

# Khóa bí mật bảo vệ trang quản trị /quan-tri/r1 và API xuất CSV (đổi sang chuỗi ngẫu nhiên dài)
ADMIN_KEY="thay_bang_khoa_quan_tri_ngau_nhien"

# ==========================================================
# Các cấu hình khác của hệ thống xemboi.vn
# ==========================================================
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_SITE_URL="https://v3.xemtuvi.vn"
NEXT_PUBLIC_SITE_NAME="XemBoi.vn"

# Cổng thanh toán (KHÔNG dùng ở trang R1)
SEPAY_API_KEY=""
VIETQR_BANK_ID=""
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""

# AI LLM Engine (tùy chọn, KHÔNG dùng ở trang R1)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

    {
      "so": 2,
      "kyHieu": "䷁",
      "ten": "坤",
      "queTu": "元亨利牝馬之貞君子有攸往先迷後得主利西南得朋東北喪朋安貞吉",
      "hao": [
        { "viTri": "初六", "van": "履霜堅冰至" },
        { "viTri": "六二", "van": "直方大不習无不利" },
        { "viTri": "六三", "van": "含章可貞或從王事无成有終" },
        { "viTri": "六四", "van": "括囊无咎无譽" },
        { "viTri": "六五", "van": "黃裳元吉" },
        { "viTri": "上六", "van": "龍戰于野其血玄黃" }

      "dung": { "viTri": "用六", "van": "利永貞" }
    },
    {
      "so": 3,
      "kyHieu": "䷂",
      "ten": "屯",
      "queTu": "元亨利貞勿用有攸往利建侯",
      "hao": [
        { "viTri": "初九", "van": "磐桓利居貞利建侯" },
        { "viTri": "六二", "van": "屯如邅如乘馬班如匪寇婚媾女子貞不字十年乃字" },
        { "viTri": "六三", "van": "即鹿無虞惟入于林中君子幾不如舍往吝" },
        { "viTri": "六四", "van": "乘馬班如求婚媾往吉无不利" },
        { "viTri": "九五", "van": "屯其膏小貞吉大貞凶" },
        { "viTri": "上六", "van": "乘馬班如泣血漣如" }
      ],
      "dung": null
    },
    {
      "so": 4,
      "kyHieu": "䷃",
      "ten": "蒙",
      "queTu": "亨匪我求童蒙童蒙來求我初筮告再三瀆瀆則不告利貞",
      "hao": [
        { "viTri": "初六", "van": "發蒙利用刑人用說桎梏以往吝" },
        { "viTri": "九二", "van": "苞蒙吉納婦吉子克家" },
        { "viTri": "六三", "van": "勿用取女見金夫不有躬无攸利" },
        { "viTri": "六四", "van": "困蒙吝" },
        { "viTri": "六五", "van": "童蒙吉" },
        { "viTri": "上九", "van": "擊蒙不利為寇利禦寇" }
      ],
      "dung": null
    },
    {
